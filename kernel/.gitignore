# ── Build outputs for the vendored CodeOS kernel tree ──
# Everything under this tree that is generated by `make -C Zircon/kernel`
# lives here; the sources themselves are tracked.

*.o
*.d

# Kernel images / ISOs / disk images produced by the kernel Makefile
/codeos-1-kernel.bin
/codeos-1-kernel-stage1.bin
/codeos-1-kernel.flat.bin
/codeos-1.0.iso
/codeos-1-kernel-grub.iso
/zircon-kernel-arm64.bin
/disk.img
/disk.img-legacy

# Generated sources / embed artefacts
/kernel/initramfs_files.c
/kernel/embed_kernel.S

# Userspace program binaries: sources live in programs/, include/, lib/ and
# the .S/.ld files directly under userspace/, so ignore only the linked ELFs.
/userspace/*
!/userspace/Makefile
!/userspace/*.S
!/userspace/*.ld
!/userspace/games/
!/userspace/icons/
!/userspace/include/
!/userspace/lib/
!/userspace/programs/

# Rust build trees
**/target/
